# 复制为 .env 后按需调整。模拟模式无需密钥，也不会请求模型服务。
# 网页入口固定模式：/review 正式、/demo 模拟；首页为动态展示；此项仅供脚本默认值使用。
ANALYSIS_MODE=mock
PDF_TEXT_ENGINE=pdfplumber
MAX_PDF_MB=20
MAX_PDF_PAGES=100
MAX_TEXT_CHARACTERS=200000
# 只统计中英文、数字等字母数字字符；阈值仅作初步筛查，不保证解析准确。
MIN_PAGE_TEXT_CHARACTERS=30
MIN_DOCUMENT_TEXT_CHARACTERS=50

# 真实 API：兼容 Chat Completions 的服务。密钥只放 .env 或系统环境变量。
# MODEL_BASE_URL 填 API 根地址（通常以 /v1 结尾），不填含密钥的 URL。
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# 兼容与请求预算为后台预设，不在网页中展示；部署维护者可在此调整。
MODEL_TIMEOUT_SECONDS=120
MODEL_CHUNK_CHARACTERS=3000
MODEL_BATCH_CHARACTERS=32000
MODEL_MAX_PROMPT_CHARACTERS=40000
MODEL_MAX_SYNTHESIS_CHARACTERS=24000
MODEL_MAX_CALLS=40
MODEL_MAX_OUTPUT_TOKENS=0
# 服务支持时可选 json_schema；若不支持格式参数可设 none，程序校验仍执行。
MODEL_RESPONSE_FORMAT=json_object
MODEL_TOKEN_PARAMETER=max_tokens
